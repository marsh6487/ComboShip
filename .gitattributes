patches/libultraship-custom-tex-scroll-e3cd6591.patch whitespace=-blank-at-eol
# Visual-review animations are delivered separately, never in source archives.
*.gif export-ignore
*.apng export-ignore
*.mp4 export-ignore
*.webm export-ignore
*.mov export-ignore
*.mkv export-ignore
*.avi export-ignore
