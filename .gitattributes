# Preserve the supplied reference exports, including their original line endings.
tools/nei_gi/REFERENCES/room_key/*.obj whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
tools/nei_gi/REFERENCES/room_key/*.mtl whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
